ENV=prod
APP_NAME=깡터
BASE_URL=https://your-domain.kr
SECRET_KEY=  # python -c "import secrets;print(secrets.token_urlsafe(48))"
# Supabase > Project Settings > Database > Connection string (Transaction pooler, 6543)
DATABASE_URL=postgresql+psycopg://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# 이미지: Cloudflare R2 (S3 호환)
STORAGE_BACKEND=s3
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=kkangter-images
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE=https://img.your-domain.kr
# developers.kakao.com > 내 애플리케이션 > REST API 키 / 보안 > Client Secret
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# python -m app.cli vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# 첫 로그인 후 카카오 회원번호를 넣거나 `python -m app.cli admin <id>`
ADMIN_IDS=
# 출시 전: 1 → 홈이 베타 신청 페이지로 이동 (관리자는 앱 미리보기 가능)
PRELAUNCH=1
# 사진 자동 인식 (없으면 버튼 숨김)
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-5-5
VISION_DAILY_LIMIT=30
